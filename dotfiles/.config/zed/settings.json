{
  // ============================================================
  // Extensions
  // ============================================================
  "auto_install_extensions": {
    "catppuccin": true,
    "catppuccin-icons": true,
  },

  // ============================================================
  // General settings
  // ============================================================
  "cli_default_open_behavior": "existing_window",

  // ============================================================
  // Appearance
  // ============================================================
  "theme": "Catppuccin Macchiato",
  "icon_theme": "Catppuccin Macchiato",
  "buffer_font_family": "MesloLGS Nerd Font Mono",
  "buffer_font_size": 14.0,
  "buffer_line_height": "comfortable",
  "minimap": {
    "max_width_columns": 50,
    "show": "always",
  },
  "tab_bar": {
    "show": true,
    "show_nav_history_buttons": false,
  },
  "active_pane_modifiers": {
    "inactive_opacity": 1.0,
  },

  // ============================================================
  // Editor behavior
  // ============================================================
  "current_line_highlight": "all",
  "format_on_save": "on",
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "tabs": {
    "git_status": true,
  },

  // ============================================================
  // Vim mode
  // ============================================================
  "vim_mode": true,
  "vim": {
    "cursor_shape": {
      "normal": "bar",
    },
    "toggle_relative_line_numbers": true,
  },

  // ============================================================
  // Language settings
  // ============================================================
  "languages": {
    "Shell Script": {
      "language_servers": ["bash-language-server"],
      "formatter": {
        "external": {
          "command": "shfmt",
          "arguments": ["-i", "2", "-ci"],
        },
      },
    },
  },

  // ============================================================
  // Terminal
  // ============================================================
  "terminal": {
    "env": {
      "IN_ZED": "1"
    },
  },

  // ============================================================
  // AI assistants
  // ============================================================
  "disable_ai": false,
  "agent_servers": {
    "github-copilot-cli": {
      "type": "registry",
    },
    "claude-acp": {
      "default_config_options": {
        "fast": false,
      },
      "type": "registry",
    },
  },

  // ============================================================
  // Git
  // ============================================================
  "git": {
    "inline_blame": {
      "enabled": true,
      "delay_ms": 500,
    },
  },

  // ============================================================
  // Telemetry
  // ============================================================
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false,
  },
}
